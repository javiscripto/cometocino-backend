<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso Administrador | Cometocino</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <style>
      :root {
        --font: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --bg: #fbf7f4;
        --surface: #ffffff;
        --primary: #9e2a2b;
        --primary-hover: #7f1d1d;
        --text: #29231f;
        --text-muted: #6e655f;
        --border: #e6ded7;
        --shadow: 0 10px 30px rgba(45, 20, 10, 0.08);
      }

      * { box-sizing: border-box; }
      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        margin: 0;
        padding: 20px;
        font-family: var(--font);
        background: radial-gradient(circle at 50% 10%, #fff4ed 0%, var(--bg) 100%);
        color: var(--text);
      }

      main {
        width: min(100%, 420px);
        padding: 36px 32px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
      }

      .brand-badge {
        font-size: 2.2rem;
        margin-bottom: 8px;
        display: inline-block;
      }
      h1 {
        margin: 0 0 6px;
        color: var(--primary);
        font-size: 1.65rem;
      }
      .subtitle {
        margin: 0 0 24px;
        color: var(--text-muted);
        font-size: 0.92rem;
      }

      form {
        display: grid;
        gap: 18px;
      }
      label {
        display: grid;
        gap: 6px;
        font-weight: 600;
        font-size: 0.88rem;
      }
      input {
        box-sizing: border-box;
        width: 100%;
        padding: 11px 13px;
        border: 1px solid var(--border);
        border-radius: 7px;
        font: inherit;
        font-size: 0.95rem;
      }
      input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(158, 42, 43, 0.15);
      }

      button {
        padding: 13px;
        border: 0;
        border-radius: 7px;
        background: var(--primary);
        color: white;
        font: inherit;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s;
        margin-top: 6px;
      }
      button:hover {
        background: var(--primary-hover);
      }

      .error-alert {
        padding: 12px 14px;
        border-radius: 7px;
        background: #ffebee;
        border: 1px solid #ffcdd2;
        color: #8e1b24;
        font-size: 0.88rem;
        margin-bottom: 20px;
      }
    </style>
    <link rel="stylesheet" href="/css/admin-theme.css" />
  </head>
  <body>
    <main class="login-card">
      <div style="text-align: center;">
        <span class="brand-badge">🥓</span>
        <h1>Cometocino Admin</h1>
        <p class="subtitle">Ingresa con tu cuenta de administrador</p>
      </div>

      <% if (error) { %>
        <div class="error-alert">✕ <%= error %></div>
      <% } %>

      <form action="/admin/login" method="post">
        <label>Correo electrónico
          <input name="email" type="email" autocomplete="username" placeholder="admin@cometocino.cl" required />
        </label>
        <label>Contraseña
          <input name="password" type="password" autocomplete="current-password" placeholder="••••••••••••" required />
        </label>
        <button type="submit">Iniciar Sesión</button>
      </form>
    </main>
  </body>
</html>
